{
  "engine": "strata",
  "backend": "sycl",
  "exe": "/path/to/Strata/build/strata",
  "cwd": "/path/to/Strata",
  "tokenizer": "/path/to/pack/tokenizer",
  "model_name": "qwen3.8-flash-next-ud-q4_k_xl-strata",
  "gpu": [0, 1, 2, 3],
  "gpu_order": "as_given",
  "layer_split": "auto",
  "log": "/path/to/logs/engine.log",
  "host": "127.0.0.1",
  "port": 8080,
  "env": {
    "ONEAPI_DEVICE_SELECTOR": "level_zero:*",
    "SYCL_CACHE_PERSISTENT": "0",
    "ZES_ENABLE_SYSMAN": "1",
    "STRATA_VERIFY_DEVICE_PLAN": "1",
    "STRATA_VERIFY_NO_HOST": "1",
    "STRATA_STAGER_THREADS": "12",
    "STRATA_MIRROR_MIB": "0",
    "STRATA_STAGE_TRIM": "1",
    "STRATA_OWNED_PRICE": "exact",
    "STRATA_QSA_PREFILL_TILED": "1",
    "STRATA_ATTN_VALUE_PIPELINE": "1",
    "STRATA_MMVQ_WIDE": "1",
    "STRATA_MMVQ_WIDE_K": "1",
    "STRATA_MMVQ_A2": "1",
    "STRATA_Q6_CENTER": "1",
    "STRATA_GU_LANES": "8",
    "STRATA_GDN_COMMIT_LAYERS": "1",
    "STRATA_GDN_COMMIT_SPLIT": "1",
    "STRATA_HC_Q8": "1",
    "STRATA_MTP_PARALLEL_ARGMAX": "1",
    "STRATA_NIGHT_MMVQ": "1",
    "STRATA_NIGHT_MMVQ2": "1",
    "STRATA_NIGHT_MMVQ2_MASK": "2",
    "STRATA_NIGHT_HC": "q8",
    "STRATA_NIGHT_ATTN_BATCH": "1",
    "STRATA_NIGHT_ATTN_VPIPE": "1",
    "STRATA_NIGHT_ATTN_MERGE_ACTIVE": "1",
    "STRATA_NIGHT_TOPK_SCAN": "1",
    "STRATA_NIGHT_TOPK10": "1",
    "STRATA_NIGHT_QSA_SCORES_T": "1",
    "STRATA_NIGHT_PREFILL_EARLY": "1",
    "STRATA_NIGHT_PREFILL_F16SUM": "1",
    "STRATA_NIGHT_GDN_AB": "1",
    "STRATA_NIGHT_GDN_GRF": "1",
    "STRATA_NIGHT_SHEXP": "1",
    "STRATA_NIGHT_PREFILL_HALVES": "1",
    "STRATA_NIGHT_PREFILL_DDQ": "1",
    "STRATA_NIGHT_PREFILL_DQ32": "1",
    "STRATA_NIGHT_PREFILL_DQCACHE": "1",
    "STRATA_NIGHT_BF16": "1",
    "STRATA_NIGHT_PREFILL_GROUPED": "1",
    "STRATA_NIGHT_PATTN_XMX": "2",
    "STRATA_PROMPT_ATTN_XMX": "0"
  },
  "args": [
    "--pack", "/path/to/pack",
    "--native", "/path/to/models/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf",
    "--ple-gguf", "/path/to/models/Qwen3.8-Flash-Next-UD-Q4_K_XL-00002-of-00004.gguf",
    "--expert-profile", "/path/to/Strata/data/expert-profile-sycl.bin",
    "--expert-cache", "auto",
    "--prefill", "8192",
    "--no-prefill-borrow",
    "--spec", "6",
    "--spec-min-p", "0.5",
    "--mtp", "/path/to/mtp/rt",
    "--mtp-max-t", "6",
    "--suffix-draft", "0",
    "--lookup-chain", "0",
    "--max-context", "524288",
    "--kv", "int8",
    "--stream-experts",
    "--vram-reserve-mib", "1024",
    "--conversation-cache-mib", "32768",
    "--conversation-cache-slots", "4",
    "--rope-scaling", "yarn",
    "--rope-scale", "2",
    "--yarn-orig-ctx", "262144"
  ]
}
